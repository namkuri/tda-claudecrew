{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeCrew",
  "version": "0.26.0",
  "identifier": "com.claudecrew.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClaudeCrew",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ClaudeCrew",
    "homepage": "https://github.com/namkuri/tda-claudecrew",
    "shortDescription": "누구나 쓰는 Claude 에이전트 오케스트레이션",
    "longDescription": "Claude Code를 감싸 여러 AI 전문가를 한 화면에서 오케스트레이션하는 데스크톱 앱. 자기 worktree에서 병렬로 작업합니다.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English", "Japanese"]
      }
    }
  },
  "plugins": {}
}
